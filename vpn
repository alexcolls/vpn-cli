#!/bin/bash

# VPN CLI Manager v2.0.0
# Multi-provider VPN with ProtonVPN and Free VPN support

VERSION="2.0.0"
DATA_DIR="$HOME/.config/vpn-cli"
CONFIG_FILE="$DATA_DIR/config.json"
LOG_FILE="$DATA_DIR/vpn.log"
HISTORY_FILE="$DATA_DIR/history.json"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

# Initialize
init_data_dir() {
    mkdir -p "$DATA_DIR" "$DATA_DIR/free-vpn"
    [ ! -f "$CONFIG_FILE" ] && echo '{"provider":"none"}' > "$CONFIG_FILE"
    [ ! -f "$HISTORY_FILE" ] && echo "[]" > "$HISTORY_FILE"
}

print_msg() { echo -e "${1}${@:2}${NC}"; }
log_msg() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"; }
get_provider() { jq -r '.provider // "none"' "$CONFIG_FILE" 2>/dev/null || echo "none"; }
set_provider() { jq --arg p "$1" '.provider = $p' "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"; log_msg "Provider: $1"; }

show_setup_menu() {
    clear
    print_msg "$CYAN" "╔══════════════════════════════════════════════════════════╗"
    print_msg "$CYAN" "║           VPN Provider Setup                             ║"
    print_msg "$CYAN" "╚══════════════════════════════════════════════════════════╝"
    echo ""
    print_msg "$GREEN" "  1) ProtonVPN (Requires account)"
    echo "     • Secure and trusted"
    echo "     • Free tier: 3 countries"
    echo "     • Manual signup at protonvpn.com"
    echo ""
    print_msg "$BLUE" "  2) Free VPN (No account needed!) ★"
    echo "     • Completely free"
    echo "     • Uses VPNGate public servers"
    echo "     • Multiple countries"
    echo ""
    print_msg "$YELLOW" "  3) Show current provider"
    print_msg "$RED" "  0) Exit"
    echo ""
}

setup_proton() {
    print_msg "$BLUE" "🔐 Setting up ProtonVPN..."
    if ! command -v protonvpn-cli &>/dev/null; then
        print_msg "$RED" "❌ ProtonVPN CLI not installed!"
        echo ""
        echo "Install with:"
        echo "  sudo apt-get install -y protonvpn-cli"
        echo ""
        echo "Then login:"
        echo "  protonvpn-cli login"
        read -p "Press Enter..."
        return 1
    fi
    
    if ! protonvpn-cli status &>/dev/null; then
        print_msg "$YELLOW" "⚠️  Please login first:"
        protonvpn-cli login
    fi
    
    set_provider "proton"
    print_msg "$GREEN" "✅ ProtonVPN configured!"
    sleep 1
}

setup_free_vpn() {
    print_msg "$BLUE" "🆓 Setting up Free VPN..."
    
    if ! command -v openvpn &>/dev/null; then
        print_msg "$YELLOW" "📦 Installing OpenVPN..."
        sudo apt-get update && sudo apt-get install -y openvpn 2>&1 | grep -v "^Reading" | grep -v "^Building"
    fi
    
    print_msg "$GREEN" "✅ Free VPN configured!"
    print_msg "$CYAN" "ℹ️  No account needed - ready to connect!"
    set_provider "free"
    sleep 1
}

connect_proton() {
    print_msg "$CYAN" "⚡ Connecting to ProtonVPN..."
    [ -z "$1" ] && protonvpn-cli c -f || protonvpn-cli c "$1"
}

connect_free() {
    local country=${1:-US}
    print_msg "$BLUE" "🆓 Connecting to free VPN ($country)..."
    print_msg "$YELLOW" "📥 Fetching server list..."
    
    local servers=$(curl -s "https://www.vpngate.net/api/iphone/" 2>/dev/null | tail -n +3 | head -20)
    [ -z "$servers" ] && { print_msg "$RED" "❌ Failed to fetch servers"; return 1; }
    
    local config=$(echo "$servers" | grep -i "$country" | head -1 | cut -f15)
    [ -z "$config" ] && config=$(echo "$servers" | head -1 | cut -f15)
    
    local cfg_file="$DATA_DIR/free-vpn/current.ovpn"
    echo "$config" | base64 -d > "$cfg_file" 2>/dev/null
    
    print_msg "$GREEN" "✅ Config downloaded"
    print_msg "$CYAN" "→ Connecting..."
    
    sudo openvpn --config "$cfg_file" --daemon --log "$DATA_DIR/openvpn.log"
    sleep 2
    
    if pgrep -x openvpn >/dev/null; then
        print_msg "$GREEN" "✅ Connected to free VPN!"
        save_history "free" "$country"
    else
        print_msg "$RED" "❌ Connection failed"
    fi
}

disconnect_vpn() {
    local provider=$(get_provider)
    print_msg "$BLUE" "🔓 Disconnecting..."
    
    case $provider in
        proton) protonvpn-cli d ;;
        free) sudo killall openvpn 2>/dev/null; print_msg "$GREEN" "✅ Disconnected" ;;
        *) print_msg "$YELLOW" "⚠️  Not connected" ;;
    esac
}

show_status() {
    local provider=$(get_provider)
    print_msg "$BLUE" "📊 VPN Status"
    echo ""
    print_msg "$CYAN" "Provider: $provider"
    echo ""
    
    case $provider in
        proton) protonvpn-cli s ;;
        free)
            if pgrep -x openvpn >/dev/null; then
                print_msg "$GREEN" "✅ Free VPN: Connected"
            else
                print_msg "$YELLOW" "⚠️  Free VPN: Disconnected"
            fi
            ;;
        none) print_msg "$YELLOW" "⚠️  Run: vpn setup" ;;
    esac
    
    if command -v curl &>/dev/null; then
        echo ""
        print_msg "$CYAN" "🌐 IP Information:"
        local ip=$(curl -s https://api.ipify.org 2>/dev/null || echo "Unknown")
        local country=$(curl -s https://ipapi.co/json 2>/dev/null | jq -r '.country_name // "Unknown"')
        echo "  • Public IP: $ip"
        echo "  • Country: $country"
    fi
}

save_history() {
    local entry=$(jq -n --arg p "$1" --arg s "$2" --arg t "$(date -Iseconds)" '{provider:$p,server:$s,time:$t}')
    jq --argjson e "$entry" '. += [$e] | .[-10:]' "$HISTORY_FILE" > "$HISTORY_FILE.tmp" && mv "$HISTORY_FILE.tmp" "$HISTORY_FILE"
}

show_history() {
    print_msg "$BLUE" "📜 Connection History:"
    echo ""
    jq -r '.[] | "  • [\(.provider)] \(.server) - \(.time)"' "$HISTORY_FILE" 2>/dev/null || print_msg "$YELLOW" "No history"
}

show_help() {
    cat << HELP
VPN CLI Manager v${VERSION}

Usage: vpn <command> [options]

Commands:
  setup               Choose VPN provider
  connect [country]   Connect to VPN
  disconnect          Disconnect from VPN
  status              Show status and IP
  history             Show connection history
  switch              Switch provider
  help                Show this help

Examples:
  vpn setup           # First-time setup
  vpn connect         # Connect (fastest)
  vpn connect US      # Connect to US (free VPN)
  vpn status          # Check connection
  vpn disconnect      # Disconnect

Free VPN Countries:
  US, UK, JP, DE, FR, CA, AU, NL, KR, etc.

HELP
}

main() {
    init_data_dir
    local provider=$(get_provider)
    
    case "${1:-help}" in
        setup)
            while true; do
                show_setup_menu
                read -p "Select [0-3]: " choice
                case $choice in
                    1) setup_proton; break ;;
                    2) setup_free_vpn; break ;;
                    3) echo ""; print_msg "$CYAN" "Current: $provider"; echo ""; read -p "Press Enter..." ;;
                    0) exit 0 ;;
                    *) print_msg "$RED" "Invalid"; sleep 1 ;;
                esac
            done
            ;;
        connect|c)
            [ "$provider" = "none" ] && { print_msg "$RED" "❌ Run: vpn setup"; exit 1; }
            case $provider in
                proton) connect_proton "$2" ;;
                free) connect_free "$2" ;;
            esac
            ;;
        disconnect|d) disconnect_vpn ;;
        status|s) show_status ;;
        history|h) show_history ;;
        switch)
            show_setup_menu
            read -p "Switch to [1=Proton, 2=Free]: " c
            case $c in 1) setup_proton ;; 2) setup_free_vpn ;; esac
            ;;
        help|--help|-h) show_help ;;
        *) print_msg "$RED" "❌ Unknown: $1"; echo ""; show_help; exit 1 ;;
    esac
}

main "$@"